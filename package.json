{
  "name": "app-reserve",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:cloud": "vite --mode cloud --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "build:cloud": "tsc -b && vite build --mode cloud",
    "preview": "vite preview --host 127.0.0.1",
    "preview:cloud": "vite preview --mode cloud --outDir dist-cloud --host 127.0.0.1",
    "phone:serve": "node scripts/phone-serve.mjs",
    "test:phone": "node --test scripts/phone-serve.test.mjs",
    "test:off:browser": "node scripts/browser/off.integration.mjs",
    "test:ui:browser": "node scripts/browser/navigation.integration.mjs",
    "test:pwa:browser": "node scripts/browser/updates.integration.mjs",
    "test:off:edge": "node --test scripts/backend/off-edge.integration.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run src",
    "test:shared": "vitest run --config vitest.shared.config.ts",
    "env:local": "node scripts/backend/local-env.mjs",
    "backup:cloud": "node scripts/backend/cloud-backup.mjs create",
    "backup:verify": "node scripts/backend/cloud-backup.mjs verify",
    "backup:extract": "node scripts/backend/cloud-backup.mjs extract",
    "test:backup": "node --test scripts/backend/backup-archive.test.mjs scripts/backend/backup-plan.test.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset --local --no-seed",
    "test:db": "supabase test db",
    "test:db:concurrency": "node --test --test-concurrency=1 scripts/backend/concurrency.integration.mjs",
    "db:types": "node scripts/backend/generate-types.mjs",
    "test:db:api": "node --test scripts/backend/auth-api.integration.mjs",
    "db:lint": "supabase db lint --local --fail-on error"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "@zxing/browser": "0.2.1",
    "@zxing/library": "0.23.0",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "supabase": "2.122.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24"
  }
}
